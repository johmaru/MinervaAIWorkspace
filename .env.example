# LLM (OpenAI-compatible)
# Umans mode: set LLM_BASE_URL to api.code.umans.ai to auto-fetch models
# OAI-compat mode: OpenAI / vLLM / Ollama etc. — set LLM_MODELS manually
LLM_BASE_URL=https://api.code.umans.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=umans-glm-5.2
LLM_MODELS=

# Embeddings (default: LFM2.5 via Python embedder; alternatives: Xenova local ONNX)
EMBED_MODEL=LiquidAI/LFM2.5-Embedding-350M
EMBED_DIM=1024
EMBED_PROVIDER=http
# Local dev only: EMBEDDER_URL for the Python embedder service
# Docker Compose sets this automatically via environment block
EMBEDDER_URL=http://localhost:8001

# Web search (SearXNG path; requires SearXNG + scraper containers)
WEB_SEARCH_MODEL=umans-coder
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_MAX_ROUNDS=2

# Thinking Effort (LLM reasoning strength; varies per model)
THINKING_EFFORT=medium

# Database (for local `bun run dev` outside Docker; Compose overrides this)
DATABASE_URL=postgres://umans:umans@localhost:5432/umanschat

# Scraper microservice (local dev: http://localhost:8000)
SCRAPER_URL=http://localhost:8000

# SearXNG (local dev: http://localhost:8080)
SEARXNG_URL=http://localhost:8080

# Tor proxy (socks5://tor:9050 = enabled, empty = disabled)
# With Tor enabled by default in docker-compose, scraping and search go through Tor
TOR_PROXY=socks5://tor:9050
SCRAPE_PROXY=socks5://tor:9050
# Execution environment (injected into LLM prompts)
# HOST_OS: Windows / macOS / Linux (empty = auto-detect from /proc/version)
HOST_OS=
# TZ: timezone for date/time in prompts (empty = Asia/Tokyo)
TZ=

# Auth.js v5 (required for login/account creation)
# Generate with: bunx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Notion OAuth (Connections feature)
# Create a public integration at https://www.notion.so/developers
# Set redirect URI to: http://localhost:3001/api/connections/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Public URL of the app (must match redirect URI configured in Notion)
AUTH_URL=http://localhost:3001
# Also used as the base for the Google OAuth callback URI:
#   {AUTH_URL}/api/auth/callback/google

# Google OAuth (optional; enables "Sign in with Google" on the login page)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
