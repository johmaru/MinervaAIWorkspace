# LLM (UmansAI — provider is hardcoded, only API key needed)
LLM_API_KEY=your-api-key-here
LLM_MODEL=umans-glm-5.2
# Model fallback (TTFT-based: switch to fallback model when first token is slow)
# Fallback model id (empty = fallback disabled)
LLM_FALLBACK_MODEL=
# Milliseconds to wait for first token before falling back (default: 10000)
LLM_FALLBACK_TIMEOUT_MS=10000

# Embeddings (default: Xenova local ONNX — no external service needed)
# Standalone exe mode uses local ONNX. For Docker/Python embedder, set EMBED_PROVIDER=http
# and EMBED_MODEL=LiquidAI/LFM2.5-Embedding-350M with EMBED_DIM=1024.
EMBED_MODEL=Xenova/all-MiniLM-L6-v2
EMBED_DIM=384
EMBED_PROVIDER=local
# Local dev only: EMBEDDER_URL for the Python embedder service (EMBED_PROVIDER=http only)
# Docker Compose sets this automatically via environment block
EMBEDDER_URL=http://localhost:8001

# Web search (SearXNG path; requires SearXNG + scraper containers)
WEB_SEARCH_MODEL=umans-qwen3.6-35b-a3b
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_MAX_ROUNDS=3

# Thinking Effort (LLM reasoning strength; varies per model)
THINKING_EFFORT=medium

# Translation timeout in seconds (default: 30; increase for long texts or multi-candidate mode)
TRANSLATE_TIMEOUT=30

# Database (SQLite file path — relative to app root or absolute)
# Standalone exe creates data/umanschat.db on first run.
DATABASE_URL=data/umanschat.db

# Scraper microservice (empty = disabled in standalone mode; chat still works)
SCRAPER_URL=

# SearXNG (empty = disabled in standalone mode)
SEARXNG_URL=

# Tor proxy (empty = disabled)
TOR_PROXY=
SCRAPE_PROXY=
# Execution environment (injected into LLM prompts)
# HOST_OS: Windows / macOS / Linux (empty = auto-detect from /proc/version)
HOST_OS=
# TZ: timezone for date/time in prompts (empty = Asia/Tokyo)
TZ=

# Logging (optional)
# Log threshold: debug / info / warn / error (default: info)
LOG_LEVEL=info
# Write logs to data/logs/umanschat.log (true/false; auto: exe→true, Docker→false)
# LOG_FILE_ENABLED=true
# Max log file size in bytes before rotation (keeps one .log.1 backup; default 5MB)
# LOG_FILE_MAX_SIZE=5242880

# Chat export (optional; empty = disabled)
# When set, each chat turn is appended as Markdown to <CHAT_EXPORT_PATH>/<YYYY>/<MM>/<DD>/<thread-title>.md
# Relative paths resolve from the app base directory; absolute paths are used as-is.
#
# Docker only: set CHAT_EXPORT_HOST_PATH to mount a host directory into the container.
# Use forward slashes on Windows (e.g. C:/Users/YourUsername/your-folder).
# The in-container CHAT_EXPORT_PATH is automatically set to /app/chat-export.
# When empty, falls back to ./data/chat-export.
# Non-Docker (exe/dev): set CHAT_EXPORT_PATH directly to any path (absolute or relative).
# CHAT_EXPORT_PATH=
# CHAT_EXPORT_HOST_PATH=

# Auth.js v5 (required for login/account creation)
# Generate with: bunx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Security — registration control (optional; defaults are permissive)
# Lock all new account creation (true/false, default false)
REGISTRATION_LOCKED=false
# Comma-separated IPs/CIDRs allowed to create new accounts (empty = allow any IP)
# Example: 192.168.1.50,10.0.0.0/8 — only these IPs can register
# When set and the client IP cannot be determined, registration is denied (fail-closed)
ALLOWED_REGISTRATION_IPS=

# Notion OAuth (Connections feature)
# Create a public integration at https://www.notion.so/developers
# Set redirect URI to: http://localhost:3001/api/connections/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Public base URL of the app. The local default (http://localhost:3001) is fine
# for local-only use. When exposing via Cloudflare Tunnel, set this to the
# tunnel's public https://... URL so the Settings UI, tunnel status, and OAuth
# provider consoles (Notion/Google) know the public name. Redirects follow the
# incoming request Host header, so both local and public access work without
# flipping this value — the app does NOT redirect local↔public based on AUTH_URL alone.
# Notion/Google OAuth redirect URIs must list both paths if dual access is needed:
#   http://localhost:3001/api/connections/notion/callback
#   https://your-tunnel.example.com/api/connections/notion/callback
AUTH_URL=http://localhost:3001

# Google OAuth (optional; enables "Sign in with Google" on the login page)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Connections OAuth (optional; enables Gmail, Google Drive, Google Calendar connectors)
# SEPARATE from GOOGLE_CLIENT_* above — these are for the Connections feature, not login.
# Create a separate OAuth client at https://console.cloud.google.com/apis/credentials
# Redirect URIs (one per product, dual access if needed):
#   {AUTH_URL}/api/connections/gmail/callback
#   {AUTH_URL}/api/connections/google_drive/callback
#   {AUTH_URL}/api/connections/google_calendar/callback
GOOGLE_CONNECTIONS_CLIENT_ID=
GOOGLE_CONNECTIONS_CLIENT_SECRET=

# GitHub OAuth (optional; enables GitHub connector)
# Create an OAuth App at https://github.com/settings/developers
# Redirect URI: {AUTH_URL}/api/connections/github/callback
GITHUB_CONNECTIONS_CLIENT_ID=
GITHUB_CONNECTIONS_CLIENT_SECRET=

# Microsoft OAuth (optional; enables Outlook Mail + Outlook Calendar connectors)
# Register an app at https://entra.microsoft.com (App registrations)
# Redirect URIs:
#   {AUTH_URL}/api/connections/outlook/callback
#   {AUTH_URL}/api/connections/outlook_calendar/callback
# Tenant: "common" for multi-tenant (personal+work), or a specific tenant GUID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Cloudflare Tunnel (optional; exposes the app over public HTTPS without port forwarding)
# Create a named tunnel at https://one.dash.cloudflare.com/ → Networks → Tunnels
# Set the tunnel's public hostname to route to Service=http://app:3000
# Then run: docker compose --profile tunnel up -d
# When using a tunnel, set AUTH_URL above to the tunnel's public HTTPS URL.
TUNNEL_TOKEN=

# Sandbox (optional; isolated code execution via Docker)
# Auto-enables sandbox_run tool when Docker is reachable AND the prebuilt
# image is present. Build the image once: docker build -t umanschat-sandbox-python:v0.4 sandbox/python
# SANDBOX_ENABLED: auto | true | false  (auto = enable if Docker ok; true = require Docker; false = force off)
# When the app runs inside Docker Compose, mount the host Docker socket
# (see docker-compose.yml sandbox-dind note) so the app can spawn siblings.
SANDBOX_ENABLED=auto
# Prebuilt image tag (must exist locally; not published to GHCR in v0.4)
SANDBOX_IMAGE=umanschat-sandbox-python:v0.4
# Reject new runs when free/available memory % drops below this threshold
SANDBOX_MIN_FREE_MEM_PERCENT=15
# Max simultaneous sandbox containers per app process
SANDBOX_MAX_CONCURRENT=1
# code_run wall-clock timeout (seconds); container is killed on expiry
SANDBOX_DEFAULT_TIMEOUT_SEC=30
# stdout/stderr character cap after sanitization
SANDBOX_STDOUT_MAX_BYTES=4096

# MCP remote URL connector (optional)
# When true, allows http:// and private/loopback IPs for remote MCP servers (self-host/dev).
# Default: false (https-only, private IPs rejected by SSRF guard).
# MCP_ALLOW_PRIVATE_URLS=false
